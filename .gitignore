# ─────────────────────────────────────────────
# Rust build artifacts
# ─────────────────────────────────────────────
/target
**/*.rs.bk
*.pdb

# NOTE: Cargo.lock should be COMMITTED for applications
# (as opposed to libraries). Do not ignore it here.

# ─────────────────────────────────────────────
# Web build output & tooling caches
# ─────────────────────────────────────────────
/dist
/.trunk/
.DS_Store

# Dioxus build output
/target/dx

# Leptos / cargo-leptos output
/target/site
/target/server

# Wasm-pack output
/pkg
/wasm-pack/

# ─────────────────────────────────────────────
# Frontend tooling (if there is any JS/npm)
# ─────────────────────────────────────────────
node_modules/
.npm
.pnpm-store/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────
# Environment & secrets
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ─────────────────────────────────────────────
# Database files (local dev only)
# ─────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Do NOT ignore .sqlx/ — SQLx offline query cache
# must be committed for offline builds in CI.
# .sqlx/

# ─────────────────────────────────────────────
# IDE / editor
# ─────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.iml
*.swp
*.swo
*~

# ─────────────────────────────────────────────
# OS files
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────
# Logs, coverage, temp files
# ─────────────────────────────────────────────
*.log
/logs/
/coverage/
*.profraw
*.profdata
lcov.info
tarpaulin-report.*
tmp/
temp/